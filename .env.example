# Portfolio demo: invented sample data, no live services. Needs NO real keys.
# Set to "true" to run the demo; remove or set to "false" for the live admin console.
NEXT_PUBLIC_DEMO_MODE=true

# Live mode only (leave empty in demo mode; never commit real values).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
NEXT_PUBLIC_SUPABASE_FUNCTIONS_URL=https://YOUR_PROJECT.supabase.co/functions/v1

# Server-only secrets (never prefix with NEXT_PUBLIC_). Used by /api/ai/* and /api/email/*.
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
RESEND_API_KEY=
# Must be a sender on a domain verified in Resend. Default only delivers to your own Resend account email.
# RESEND_FROM_EMAIL=PetKira <hello@yourdomain.com>
